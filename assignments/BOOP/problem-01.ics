<<problem 1: Problem 1: Division is Repeated Subtraction


<<blueprint
        <<functional-correctness
              requires: 
* a : nat ∧ b : nat 
* No other preconditions on `a`. `b` may be `Zero`


              ensures: 
* The function `divmod (a, b)` returns a value of type `(nat * nat) option` satisfying:
  * `divmod a b = None` ⇔ `b = Zero`.
  * If `b ≠ Zero` then `divmod a b = Some (q, r)` such that:
    1. `q : nat` and `r : nat`.
    2. `a = b * q + r`. (Here `*` and `+` are the usual operations on `nat` defined by repeated addition.)
    3. `r < b` (strict inequality on `nat`).
* The algorithm always terminates.
        functional-correctness>>
blueprint>>



<<operational steps
1. If `b = Zero`, return `None` (division by zero is undefined).
2. Otherwise (so `b = Succ _`):

   * Start with quotient `q = Zero` and remainder `r = a`.
   * Repeatedly check: if `r < b` then stop and return `(q, r)`.
   * If `r >= b`, compute `r' = r - b` (syntactic subtraction on `nat`), increment `q` to `Succ q`, set `r := r'` and repeat.
3. Because each subtraction decreases the remainder `r` in the natural-number ordering and `r` is bounded below by `Zero`, this process must terminate.
4. Return `Some (q, r)` with `r < b` when finished.

Edge cases:

* `a = Zero` and `b ≠ Zero`: algorithm returns `Some (Zero, Zero)`.
* `a < b`: returns `Some (Zero, a)`.
=operational steps>>




<<ocaml code
type nat = Zero | Succ of nat

let rec lt (a : nat) (b : nat) : bool =
  match (a, b) with
  | (Zero, Zero) -> false
  | (Zero, Succ _) -> true
  | (Succ _ , Zero) -> false
  | (Succ a', Succ b') -> lt a' b'


let rec sub (a : nat) (b : nat) : nat =
  match (a, b) with
  | (Zero, Zero) -> Zero
  | (_, Zero) -> a
  | (Succ a', Succ b') -> sub a' b'


let rec divmod_aux (q : nat) (r : nat) (b : nat) : (nat * nat) =
  if lt r b then (q, r)
  else
    let r' = sub r b in
    divmod_aux (Succ q) r' b


let divmod (a : nat) (b : nat) : (nat * nat) option =
  match b with
  | Zero -> None
  | _ -> Some (divmod_aux Zero a b)
ocaml code>>



<<proof

        <<invariant
            Initialisation: At each call `divmod_aux q r b` (with fixed `b ≠ Zero`) the following invariant holds: `original_a = b * q + r`, where `original_a` is the initial `a` passed to `divmod` (we view `q` and `r` as the current quotient and remainder accumulated so far).

            
            Maintenance:

* Suppose `divmod_aux q r b` is called and `lt r b` is `false` (so `r >= b`).
* Then `r' = sub r b` is mathematically `r - b`.
* After the recursive call `divmod_aux (Succ q) r' b`, the new pair `(q', r') = (Succ q, r - b)` satisfies:

  * `b * (Succ q) + r' = b * q + b + (r - b) = b * q + r`, so INV is preserved.

            For input a >= b, given that the recursive call on a - b returns qk, rk 
            satisfying a - b = b * qk + rk (where rk < b), the algorithm returns 
            q = qk + 1 and r = rk. This maintains the properties:
              a = b + (a - b)
                = b + b * qk + rk
                = b * (qk + 1) + rk
                = b * q + r
              r = rk < b still holds
            
            Termination: At each recursive step, the algorithm subtracts b from the current remainder r, producing a strictly smaller value r'. Since b ≠ Zero in all recursive paths, the remainder decreases every time and cannot decrease indefinitely over natural numbers. Therefore, the recursion must eventually reach the base case where r < b, at which point the algorithm stops and returns. Hence, the function always terminates.
        invariant>>



        <<induction
            base case: `a = Zero`: then since `b ≠ Zero`, `lt Zero b = true`, so `divmod_aux Zero Zero b` returns `(Zero, Zero)`. So `0 = b*0 + 0` and `0 < b`.

            inductive hypothesis:
            For all k < a, the division function returns a quotient qk and remainder 
            rk such that: 
              (i) k = b × qk + rk 
              (ii) rk < b

            inductive step: * **Inductive step**: Suppose for all `a'` smaller than `a` the property holds. If `lt a b = true`, we return `(Zero, a)` and `a < b` holds. Otherwise, `a >= b`; let `a' = sub a b`. Note `a' < a`. By induction hypothesis, `divmod a' b = Some (q, r)` with `a' = b*q + r` and `r < b`. Then `divmod a b` returns `Some (Succ q, r)` and a = b + a' = b + (b*q + r) = b*(q+1) + r with `r < b`. So property holds.
        induction>>
        
proof>>

