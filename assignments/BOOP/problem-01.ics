<<problem 1: Problem 1: Division is Repeated Subtraction


<<blueprint
        <<functional-correctness
              requires: 
                (i) a : nat
                (ii) b : nat, b > 0:


              ensures: Returns a pair (q, r) such that:
                (i)  q : nat, r : nat 
                (ii) a = (b * q) + r
                (iii) r < b
        functional-correctness>>
blueprint>>



<<operational steps
1. If the denominator b = 0. Return error 

2. If b is non-zero:
   - We start off with the assumption that q = 0 and r = a

3. If r < b, stop recursion and return (q, r) as the quotient and remainder.

4. If r >= b, subtract b from r, increment q by 1, and recurse with the new values of q and r.

5. Continue recursively until r < b, and then return q and r
=operational steps>>




<<ocaml code
type nat = Zero | Succ of nat

let rec less_than (a : nat) (b : nat) : bool =
  match (a, b) with
  | (_, Zero) -> false
  | (Zero, Succ _) -> true
  | (Succ a', Succ b') -> less_than a' b'                    (* less than a = a' *)

let rec minus (a : nat) (b : nat) : nat =
  match (a, b) with
  | (Zero, Zero) -> Some Zero
  | (Zero, Succ _) -> None
  | (_, Zero) -> Some a
  | (Succ a', Succ b') -> minus a' b'

let rec divmod (a : nat) (b : nat) : (nat * nat) =
  match b with
  | Zero -> None                                             (* division by zero undefined *)
  | _ ->
    if less_than a b then Some (Zero, a)                     (* q = 0, r = a *)
    else
      match minus a b with
      | None -> None
      | Some diff ->
        match divmod diff b with
        | None -> None
        | Some (q, r) -> Some (Succ q, r)
ocaml code>>



<<proof

        <<invariant
            Initialisation: 
            If a < b, then q = 0 and r = a. This satisfies:
              1. a = b * 0 + a = a
              2. r = a < b
            
            Maintenance:
            For input a >= b, given that the recursive call on a - b returns qk, rk 
            satisfying a - b = b * qk + rk (where rk < b), the algorithm returns 
            q = qk + 1 and r = rk. This maintains the properties:
              a = b + (a - b)
                = b + b * qk + rk
                = b * (qk + 1) + rk
                = b * q + r
              r = rk < b still holds
            
            Termination: 
            The recursive call subtracts b from a, producing diff = a - b, which is 
            smaller than a. Since the input size decreases with each call and there 
            are a finite number of recursive calls, the base case of a < b is 
            eventually reached. The recursion stops when reaching the base case, so 
            the function terminates.
        invariant>>



        <<induction
            base case:
            If a < b, then q = 0 and r = a.
              1. a = b * 0 + a = a
              2. r = a < b

            inductive hypothesis:
            For all k < a, the division function returns a quotient qk and remainder 
            rk such that: 
              (i) k = b × qk + rk 
              (ii) rk < b

            inductive step:
            For input a >= b, the algorithm subtracts b once and calls recursively on 
            a - b, which is smaller than a. By inductive hypothesis, the recursive 
            call returns qk, rk such that a - b = b * qk + rk (where rk < b). The 
            algorithm then returns q = qk + 1, r = rk. This results in:
              a = b + (a - b)
                = b + b * qk + rk
                = b * (qk + 1) + rk
                = b * q + r
            Thus, r = rk < b still holds, and the properties are held for a.
        induction>>
        
proof>>

