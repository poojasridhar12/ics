<<problem 1: Problem 3: Egyptian Fractions

<<blueprint
        <<functional-correctness
            requires:
                (i) numerator n : int, m (denominator): int
                (ii) 0 < n < m
                (iii) original fraction n/m > 0

            ensures:
                (i) returns a finite list [d1; d2; ...; dk] of positive integers such that
    n/m = 1/d1 + 1/d2 + ... + 1/dk
                (ii) forall n in [1..k], n = 1
                (iii) m = d1 < d2 < ... < dk
                (iv) algorithm terminates in finite steps -> k : int
                (v) 1/d1 < n/m

        functional-correctness>>
blueprint>>



<<operational steps
My understanding of Egyptian fractions: representing any positive fraction as a sum of unit fractions (that don't repeat within the sum)
My understanding of the Greedy algorithm: 
- Convert a proper fraction into an Egyptian fraction by taking the largest unit fraction that is smaller than the current fraction and subtract it, until what is left is the unit fraction
- This algorithm states that every positive rational number has 1 Egyptian Fraction (https://www.wolframcloud.com/objects/nbarch/2018/10/2018-10-10pt4o2/Egyptian.nb)
- This algorithm states that there is no repetition of the unit fraction within the sum

1. Check if n > 0 and m > 0, and n < m. If this is failed, raise error

2. Base case: 
- n = 1
- the fraction is a unit fraction 1/demon, and add it to the accumulator
- return the accumulator (with all fractions so far)

3. Recursive Case n > 1
- Calcuate the largest unit fraction 1/d that is =< n/m 
  - to see what is the largest fraction, divide the original fraction and check the ceiling for division
  - ceiling is n/m rounded up to the nearest integer = d 
- subtract 1/d from n/m
  - new_num/new_denom = n/m - 1/d = (num * d - denom)/denom * d
- Simplify the remainder fraction using gcd to reduce to lowest terms (simpler_num, simpler_denom)
- the option type is added to handle the edge cases by handling any errors 
    (such as no value returned or a valid list isn't produced(or no list is      produced)) 
    (in case an invalid list is given, etc. if a valid list is given, it         returns some list)

Recursively apply the algorithm to the simplified remainder fraction, add each unique unit function to accumulator

4. Accumulator 
- add (1, d) to accumulator using prepend
- Return the accumulated list of all unit fractions
- take the list and add the function "sum" betweeen each element

5. Termination
- If new_n (after the simplification) = 0, the fraction has decomposed
- Add (1, d) to the accumulator and return the accumulator 
operational steps>>



<<ocaml code
let gcd (a : int) (b : int) : int =
  let rec gcd_helper (x : int) (y : int) : int option =
    match y with
    | 0 -> some x
    | _ -> gcd_helper y (x mod y)
  in
  gcd_helper (abs a) (abs b)

let simplify (n : int) (m : int) : (int * int) option =
let g_opt = gcd n m in
  match g_opt with
  | None -> None
  | Some g ->
    if g = 0 then None else Some (n / g, m / g)

let ceil_div (a : int) (b : int) : int =
  (a + b - 1) / b

(* decomposition by greedy algorithm *)
let egyptian_fractions (n : int) (m : int) : (int * int) list =
  if n <= 0 || m <= 0 then failwith "Numerator and denominator must be positive"
  else if n >= m then failwith "Must be a proper fraction (numerator < denominator)"
  else 
    let rec greedy_helper (num : int) (den : int) (acc : (int * int) list) : (int * int) list =
      match num with
      | 1 -> List.rev ((1, den) :: acc)
      | _ ->
        let d = ceil_div den num in
        let new_num = num * d - den in
        let new_den = den * d in
        let (simpler_num, simpler_den) = simplify new_num new_den in
        greedy_helper simpler_num simpler_den ((1, d) :: acc)
    in
    greedy_helper n m []

(* converting the list to a string with the function of sum between each fraction *)
let fraction_list_to_string (fractions : (int * int) list) : string =   fractions
  |> List.map (fun (num, den) -> Printf.sprintf "1/%d" den)
  |> String.concat " + "

ocaml code>>



<<proof

        <<invariant
            Initialisation: 
            If the numerator is 1, then 1/m is a unit fraction, and the algorithm returns 1/m, terminating immediately
            
            Maintenance:
            - Select d = ceiling (m / (n + 1)), largest unit fraction 1/d such that 1/d <= (n + 1)/m
            - Calculate the remainder: remainder = (n + 1)/m - 1/d = ((n + 1)*d - m) / (m * d)
            - Simplify to get remainder fraction n'/m' with n' < n + 1
            - Since 1/d is less than all fractions in the recursive decomposition, denominators are strictly increasing
            - d < m. This proves the strictly increasing property of denominators
            
            Termination: 
            - Numerator of the remainder fraction strictly decreases at each step, so the recursion terminates
            - n decreases in each call, and as all numerators are bound to terminate at 1, the recursion terminates after a finite amount of calls
        invariant>>



        <<induction
            base case:
            n = 1 - if the numerator is 1, then 1/m is a unit fraction, and the algorithm returns 1/m, terminating immediately

            inductive hypothesis:
            Assume that for all numerators n', with 1 =< n' =< num, the algorithm holds true, and decomposes n'/m' into a finite sum of distinct unit fractions

            inductive step:
            Prove that it is true for (n + 1)/m
            - Select d = ceiling (m / (n + 1)), largest unit fraction 1/d such that 1/d <= (n + 1)/m
            - Calculate the remainder: remainder = (n + 1)/m - 1/d = ((n + 1)*d - m) / (m * d)
            - Simplify to get remainder fraction n'/m' with n' < n + 1
            - By inductive hypothesis, the algorithm correctly decomposes n'/m'
            - Prepend 1/d to this decomposition to form the decomposition of (n + 1)/m
            - Therefore, the algorithm correctly and finitely decomposes any proper fraction into a sum of distinct unit fractions
        induction>>
        
proof>>

